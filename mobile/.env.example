# Salin menjadi .env lalu isi dengan kredensial project Supabase Anda.
# JANGAN commit file .env ke Git — hanya anon key (bukan service_role) yang dipakai di aplikasi.
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL layanan verifikasi wajah self-hosted (CompreFace), mis. http://vps-perusahaan:8000
EXPO_PUBLIC_FACE_API_URL=http://localhost:8000
EXPO_PUBLIC_FACE_API_KEY=
